# Chave da API do Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Remetente. Sem domínio verificado no Resend, use onboarding@resend.dev
# (nesse modo o Resend só entrega para o email da própria conta).
# Com domínio verificado: noreply@seudominio.com.br
SENDER_EMAIL=pedidos@envio.centraldeatacados.com.br
SENDER_NAME=Ambev Brasil

# Para onde vão as respostas dos clientes (uma caixa real que você lê)
REPLY_TO=rodrigobencaodasilva@gmail.com

# Nome e email exibidos no rodapé dos emails (opcional; padrão = SENDER_NAME / REPLY_TO)
COMPANY_NAME=Ambev Brasil
CONTACT_EMAIL=rodrigobencaodasilva@gmail.com

# Prazo do pagamento em minutos
PAYMENT_DEADLINE_MINUTES=20

PORT=3000
